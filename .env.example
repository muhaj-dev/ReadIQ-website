# readIQ website — AI configuration.
# Copy to ".env.local" (git-ignored) for local dev, and add the same two
# variables in Vercel → Project → Settings → Environment Variables.
# They are read ONLY on the server (src/server/ai-proxy.ts) — the browser never sees them.

# Groq — chat (Ask, quiz, summaries, podcast) + Record transcription (Whisper)
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Gemini — PDF upload, Scan OCR, embeddings (semantic note search)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
